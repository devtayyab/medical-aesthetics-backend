# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=medical_aesthetics

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-here
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-here
JWT_EXPIRATION=1d
JWT_REFRESH_EXPIRATION=7d

# Redis Configuration (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Firebase Configuration (for Push Notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-service-account-email
FIREBASE_PRIVATE_KEY=firebase-private-key

# SMS Gateway Configuration
SMS_GATEWAY_URL=https://api.sms-gateway.com
SMS_GATEWAY_API_KEY=your-sms-api-key

# Facebook API Configuration (for Lead Integration)
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_API_VERSION=v18.0

# Viber Configuration
VIBER_API_URL=https://chatapi.viber.com/pa
VIBER_AUTH_TOKEN=your-viber-auth-token

# Google Calendar Sync (one OAuth app shared by all clinics; each clinic authorizes its own account)
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET come from Google Cloud Console → APIs & Services → Credentials.
# The feature is inert unless GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and GOOGLE_OAUTH_REDIRECT_URI are set.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must be registered under the OAuth client's "Authorized redirect URIs"
GOOGLE_OAUTH_REDIRECT_URI=https://api.yourdomain.com/api/google-calendar/oauth/callback
# Public HTTPS URL Google posts push notifications to (domain must be verified in Google)
GOOGLE_WEBHOOK_CALLBACK_URL=https://api.yourdomain.com/api/google-calendar/webhook
# 32-byte key to encrypt stored OAuth tokens: generate with `openssl rand -hex 32`
GOOGLE_TOKEN_ENC_KEY=your-64-char-hex-key
# OAuth scopes (space/comma separated). calendar = full read/write on the dedicated calendar.
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar
# Frontend base URL to redirect the clinic owner back to after connecting
APP_FRONTEND_URL=https://app.yourdomain.com
# Set to 'true' to also export client phone + appointment notes into Google events.
# Default (unset/false) exports only service, client name, provider and status
# (data minimization; free-text/clinical notes are never exported unless enabled).
GOOGLE_CALENDAR_INCLUDE_CONTACT=false

# Application Configuration
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# GDPR Compliance
DATA_RETENTION_DAYS=2555 # 7 years
CONSENT_VERSION=1.0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100