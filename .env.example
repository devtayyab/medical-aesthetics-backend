# ==============================================================================
# Medical Aesthetics Platform - Backend Environment Configuration (.env.example)
# ==============================================================================

# Database Configuration (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=medical_aesthetics
DB_SYNCHRONIZE=false

# JWT Authentication (required in production: startup fails if JWT_SECRET and JWT_ACCESS_SECRET are both unset)
JWT_SECRET=your-super-secret-jwt-key-here
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-here
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-here
JWT_EXPIRATION=1d
JWT_REFRESH_EXPIRATION=7d

# Redis Configuration (BullMQ async queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Firebase Push Notifications
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-service-account-email
FIREBASE_PRIVATE_KEY=firebase-private-key

# SMS Gateway Configuration
SMS_GATEWAY_URL=https://api.sms-gateway.com
SMS_GATEWAY_API_KEY=your-sms-api-key

# Email (SMTP) Configuration — used for OTPs, notifications, and contact form
MAIL_HOST=email-smtp.eu-central-1.amazonaws.com
MAIL_PORT=587
MAIL_USER=your-smtp-username
MAIL_PASS=your-smtp-password
MAIL_FROM=no-reply@beautydoctors.gr
SUPPORT_EMAIL=info@beautydoctors.gr

# Facebook Lead Integration
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_API_VERSION=v18.0
# Required: Meta webhook verify token (no default; webhook verification fails without it)
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your-facebook-webhook-verify-token

# Viber Messaging
VIBER_API_URL=https://chatapi.viber.com/pa
VIBER_AUTH_TOKEN=your-viber-auth-token

# Google Calendar OAuth Integration
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://api.yourdomain.com/api/google-calendar/oauth/callback
GOOGLE_WEBHOOK_CALLBACK_URL=https://api.yourdomain.com/api/google-calendar/webhook
GOOGLE_TOKEN_ENC_KEY=your-64-char-hex-key
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar
GOOGLE_CALENDAR_INCLUDE_CONTACT=false

# Viva Wallet Configuration (Card Payments)
VIVA_API_URL=https://api.vivapayments.com
VIVA_ACCOUNTS_URL=https://accounts.vivapayments.com
VIVA_CLIENT_ID=your-viva-client-id
VIVA_CLIENT_SECRET=your-viva-client-secret
VIVA_MERCHANT_ID=your-viva-merchant-id
VIVA_API_KEY=your-viva-api-key
VIVA_SOURCE_CODE=Default

# HubSpot CRM Integration
HUBSPOT_API_TOKEN=your-hubspot-api-token

# Application Runtime Configuration
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
APP_FRONTEND_URL=http://localhost:5173

# GDPR Compliance
DATA_RETENTION_DAYS=2555 # 7 years
CONSENT_VERSION=1.0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100